# MyWhoosh
MYWHOOSH_EMAIL=your_email@example.com
MYWHOOSH_PASSWORD=your_password

# Garmin Connect
GARMIN_USERNAME=your_garmin_email

# Provide ONE of the following for Garmin auth:
#  - GARMIN_PASSWORD: simple, but fails if the account uses MFA or hits a captcha
#  - GARMIN_TOKEN_BASE64: recommended for headless / GitHub Actions.
#    Generate it once with: python generate_garmin_token.py
GARMIN_PASSWORD=your_garmin_password
# GARMIN_TOKEN_BASE64=

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
